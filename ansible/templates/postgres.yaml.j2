---
# CloudNativePG Operator must be installed before applying this file.
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: authentik-pg
  namespace: {{ authentik_namespace }}
spec:
  instances: {{ postgres_instances }}
  imageName: ghcr.io/cloudnative-pg/postgresql:16

  postgresql:
    parameters:
      max_connections: "200"
      shared_buffers: "128MB"

  bootstrap:
    initdb:
      database: {{ postgres_database | to_json }}
      owner: {{ postgres_user | to_json }}
      secret:
        name: authentik-pg-credentials

  storage:
    size: {{ postgres_storage_size }}
    storageClass: {{ storage_class | to_json }}

  resources:
    requests:
      memory: "256Mi"
      cpu: "100m"
    limits:
      memory: "512Mi"
      cpu: "500m"

  monitoring:
    enablePodMonitor: false
