apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: gp3
provisioner: ebs.csi.aws.com
volumeBindingMode: WaitForFirstConsumer
# Retain keeps EBS volumes after PVC deletion (production); Delete removes them (demo).
reclaimPolicy: {{ ebs_reclaim_policy }}
parameters:
  type: gp3
  encrypted: "true"
