apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: authentik-acme
spec:
  acme:
    email: {{ acme_email | to_json }}
    server: {{ acme_server | to_json }}
    privateKeySecretRef:
      name: authentik-acme-account
    solvers:
      - http01:
          ingress:
            ingressClassName: acme-http
            serviceType: ClusterIP
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: authentik-web
  namespace: {{ ingress_namespace }}
spec:
  secretName: authentik-web-tls
  dnsNames:
    - {{ authentik_domain | to_json }}
  privateKey:
    algorithm: RSA
    size: 2048
    rotationPolicy: Always
  issuerRef:
    name: authentik-acme
    kind: ClusterIssuer
