# Authentik Blueprint: RADIUS Outpost + Provider
#
# RADIUS auth: username (member number) or email + password
# Authentik RADIUS outpost listens on UDP 1812
#
# The RADIUS outpost runs as a separate Deployment in the cluster,
# exposed by a Kubernetes Service in native deployments.

version: 1
metadata:
  name: radius-outpost
  labels:
    blueprints.goauthentik.io/description: "RADIUS provider and outpost for password auth"

entries:
  # Authentication flow for RADIUS (password only, no MFA stage for now)
  - model: authentik_flows.flow
    identifiers:
      slug: radius-authentication
    attrs:
      name: "RADIUS Authentication"
      title: "RADIUS Authentication"
      slug: radius-authentication
      designation: authentication
      authentication: none

  # Identification stage: resolve username to user
  - model: authentik_stages_identification.identificationstage
    identifiers:
      name: radius-identification
    attrs:
      name: radius-identification
      # Email addresses are assumed unique, as for the default login.
      user_fields:
        - username
        - email
      pretend_user_exists: true

  # Password stage
  - model: authentik_stages_password.passwordstage
    identifiers:
      name: radius-password
    attrs:
      name: radius-password
      backends:
        - authentik.core.auth.InbuiltBackend

  # User login stage
  - model: authentik_stages_user_login.userloginstage
    identifiers:
      name: radius-user-login
    attrs:
      name: radius-user-login
      session_duration: "hours=1"
      remember_me_offset: "days=0"

  # Flow bindings
  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, radius-authentication]]
      order: 10
    attrs:
      target: !Find [authentik_flows.flow, [slug, radius-authentication]]
      stage: !Find [authentik_stages_identification.identificationstage, [name, radius-identification]]
      order: 10

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, radius-authentication]]
      order: 20
    attrs:
      target: !Find [authentik_flows.flow, [slug, radius-authentication]]
      stage: !Find [authentik_stages_password.passwordstage, [name, radius-password]]
      order: 20

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, radius-authentication]]
      order: 30
    attrs:
      target: !Find [authentik_flows.flow, [slug, radius-authentication]]
      stage: !Find [authentik_stages_user_login.userloginstage, [name, radius-user-login]]
      order: 30

  # Invalidation flow (required by RadiusProvider in 2026.x)
  - model: authentik_flows.flow
    identifiers:
      slug: radius-invalidation
    attrs:
      name: "RADIUS Invalidation"
      title: "RADIUS Invalidation"
      slug: radius-invalidation
      designation: invalidation
      authentication: none

  # RADIUS Provider
  - model: authentik_providers_radius.radiusprovider
    identifiers:
      name: radius-provider
    attrs:
      name: "RADIUS Provider"
      authorization_flow: !Find [authentik_flows.flow, [slug, radius-authentication]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, radius-invalidation]]
      shared_secret: {{ radius_shared_secret | default('CHANGE_ME_RADIUS_SECRET') | to_json }}
      client_networks: {{ radius_client_networks | to_json }}

{% if radius_enabled %}
  # The outpost API only exposes providers linked to an application.
  - model: authentik_core.application
    identifiers:
      slug: radius
    attrs:
      name: RADIUS
      slug: radius
      provider: !Find [authentik_providers_radius.radiusprovider, [name, radius-provider]]

  # Only radius-users may authenticate; certificate enrollment adds new users.
  - model: authentik_core.group
    identifiers:
      name: radius-users
    attrs:
      name: radius-users

  - model: authentik_policies.policybinding
    identifiers:
      target: !Find [authentik_core.application, [slug, radius]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, radius]]
      group: !Find [authentik_core.group, [name, radius-users]]
      order: 0
{% endif %}

  # RADIUS Outpost
  - model: authentik_outposts.outpost
    identifiers:
      name: radius-outpost
    attrs:
      name: "RADIUS Outpost"
      type: radius
      providers:
        - !Find [authentik_providers_radius.radiusprovider, [name, radius-provider]]
      config:
        authentik_host: "http://authentik-server.{{ authentik_namespace }}.svc.cluster.local"
        authentik_host_insecure: true
        kubernetes_replicas: 1
        kubernetes_service_type: ClusterIP
