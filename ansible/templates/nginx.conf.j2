worker_processes auto;
worker_shutdown_timeout 45s;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    log_format edge '$remote_addr "$request_method $uri" status=$status '
                    'mtls=$ssl_client_verify connection=$connection:$connection_requests '
                    'upstream_status=$upstream_status';
    access_log /dev/stdout edge;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
{% if proxy_protocol_enabled | default(false) %}
    # Only explicitly trusted upstream proxies may supply a client address.
{% for cidr in proxy_protocol_trusted_cidrs %}
    set_real_ip_from {{ cidr }};
{% endfor %}
    real_ip_header proxy_protocol;
{% endif %}
    server {
        listen 8080;
        location = /healthz { access_log off; return 200 "ok\n"; }
        location / { return 404; }
    }
    server {
        listen 8443 ssl{% if proxy_protocol_enabled | default(false) %} proxy_protocol{% endif %};
        server_name {{ authentik_domain }};
        ssl_certificate /etc/nginx/tls/tls.crt;
        ssl_certificate_key /etc/nginx/tls/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_client_certificate /etc/nginx/client-ca/ca.crt;
        ssl_verify_client optional;
        ssl_verify_depth 4;
        # Revalidate the certificate on each new TLS connection after CA changes.
        ssl_session_cache off;
        ssl_session_tickets off;
{% for cidr in allowed_cidrs_json | from_json %}
        allow {{ cidr }};
{% endfor %}
        deny all;
        client_max_body_size 20m;
        location / {
            proxy_pass http://authentik-server.{{ authentik_namespace }}.svc.cluster.local:80;
            proxy_http_version 1.1;
            proxy_set_header Host {{ authentik_domain }};
            proxy_set_header X-Forwarded-Host {{ authentik_domain }};
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Port 443;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
            # Overwrite the identity header; the flow parses the actual X.509.
            proxy_set_header X-Amzn-Mtls-Clientcert-Leaf $ssl_client_escaped_cert;
            proxy_set_header X-Amzn-Mtls-Clientcert-Subject $ssl_client_s_dn;
            proxy_set_header X-Amzn-Mtls-Clientcert-Issuer $ssl_client_i_dn;
            proxy_set_header X-Amzn-Mtls-Clientcert-Serial-Number $ssl_client_serial;
            proxy_set_header X-Amzn-Mtls-Clientcert "";
            proxy_set_header X-Amzn-Mtls-Clientcert-Sans "";
            proxy_set_header X-Amzn-Mtls-Clientcert-Validity "";
        }
    }
}
