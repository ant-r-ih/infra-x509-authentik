aws_region  = "ap-northeast-1"
aws_profile = "infra-prod" # production infrastructure account

cluster_name = "x509-authentik"
vpc_cidr     = "10.0.0.0/16"
# HTTPS clients allowed by nginx; HTTP01 validation remains public.
# With ssh_demo_enabled, the VPC NACL also limits TCP 22 to these CIDRs.
allowed_cidrs = ["0.0.0.0/0"]
# Retain keeps PostgreSQL EBS volumes after PVC deletion; use Delete for demos.
ebs_reclaim_policy = "Retain"
# RADIUS-authenticated SSH demo device on NLB TCP 22.
ssh_demo_enabled = false
# EKS API access for operators; restrict to your management network.
api_allowed_cidrs = ["0.0.0.0/0"]

kubernetes_version  = "1.37"
spot_instance_types = ["t4g.medium", "t4g.large"]
desired_nodes       = 2
min_nodes           = 1
max_nodes           = 4

authentik_domain = "auth.example.org"
# HTTP01: point this domain at the NLB; TCP 80 must remain public for renewals.
acme_email = "admin@example.org"
# For initial HTTP validation testing (staging certificates are NOT browser-trusted):
# acme_server = "https://acme-staging-v02.api.letsencrypt.org/directory"

# Set bootstrap credentials in .env:
# TF_VAR_authentik_bootstrap_email and TF_VAR_authentik_bootstrap_password
