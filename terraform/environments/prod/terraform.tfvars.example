aws_region   = "ap-northeast-1"
aws_profile  = "infra-prod"   # production infrastructure account

cluster_name = "x509-authentik"
vpc_cidr     = "10.0.0.0/16"
allowed_cidrs = ["0.0.0.0/0"]

kubernetes_version  = "1.37"
spot_instance_types = ["t3.medium", "t3a.medium", "t3.large"]
desired_nodes       = 2
min_nodes           = 1
max_nodes           = 4

authentik_domain    = "auth.example.org"
# HTTP01: point this domain at the NLB; TCP 80 must remain public for renewals.
acme_email          = "admin@example.org"
# For initial HTTP validation testing (staging certificates are NOT browser-trusted):
# acme_server = "https://acme-staging-v02.api.letsencrypt.org/directory"

# Sensitive: set via .env as TF_VAR_authentik_bootstrap_email instead of here
# authentik_bootstrap_email = "admin@example.org"
