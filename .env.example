# Operator-provided values for Terraform.
# Copy to .env, fill in, then: source .env && terraform apply
#
# Passwords and secret keys are generated automatically by Terraform
# (random_password resources) and injected into Ansible via the
# cloud.terraform.terraform_provider inventory plugin.
# Only values that cannot be auto-generated belong here.

export TF_VAR_authentik_bootstrap_email="admin@example.org"
export TF_VAR_authentik_bootstrap_password="CHANGE_ME"
